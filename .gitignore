# Dependencies
node_modules/
bun.lock

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Compiled documents
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Secrets — API credentials. NEVER commit these.
# bun auto-loads a repo-root .env, so the portal CLIs pick these up with no extra wiring.
.env
.env.*
!.env.example

# Personal data (never commit these)
salary_data.json
profiles/*/job_scraper/seen_jobs.json
profiles/*/job_scraper/*.md
*_BehavioralReport.pdf
linkedin_Profile.pdf

# Personal photos and signatures
*.jpg
*.jpeg
*.png
!profiles/*/cover_letters/OpenFonts/fonts/**

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/

# Skills lock (auto-generated)
skills-lock.json

# Personal application output files (generated by /apply — do not share)
profiles/*/cv/main_*.tex
!profiles/*/cv/main_example.tex
profiles/*/cv/*.txt
profiles/*/cover_letters/cover_*.tex
profiles/*/cover_letters/Cover_*.tex
!profiles/example/cover_letters/cover_example.tex

# documents/ subfolder contents are personal — only README and folder structure are tracked
profiles/*/documents/cv/**
profiles/*/documents/linkedin/**
profiles/*/documents/diplomas/**
profiles/*/documents/references/**
profiles/*/documents/applications/**
!profiles/*/documents/**/.gitkeep

# Personal job search tracking
profiles/*/job_search_tracker.csv

# Upskill reports (personal output)
profiles/*/upskill/*.md

# Agent skills: track the source, ignore only deps and logs.
# (A blanket `.agents/` ignore silently drops the job-search CLI skills from the repo.)
.agents/**/node_modules/
.agents/**/*.log
.agents/usage/

# Real candidate profiles are local-only, including manifests and source CVs.
# Only the blank reusable scaffold and generic documentation may be tracked.
/profiles/*
!/profiles/README.md
!/profiles/example/

# Legacy personal-data locations and machine-specific agent settings.
/cv/
/cover_letters/
/documents/
/job_scraper/
/upskill/
/job_search_tracker.csv
.claude/settings.local.json
.claude/skills/job-application-assistant/01-candidate-profile.md
.claude/skills/job-application-assistant/02-behavioral-profile.md
.claude/skills/job-application-assistant/04-job-evaluation.md
.claude/skills/job-application-assistant/07-interview-prep.md
.claude/skills/job-scraper/search-queries.md

# Defence against legacy workflows writing outside their selected profile.
/reports/
/company_research/
/gmail_sync/
**/job_scraper/seen_jobs.json
**/job_scraper/notion_sync.json
**/job_scraper/*.md
**/upskill/report-*.md
